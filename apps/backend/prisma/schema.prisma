generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int    @id @default(autoincrement())
  username String @unique

  entries    Entry[]
  activities Activity[]
  groups     Group[]
  media      Media[]

  @@map("users")
}

model Group {
  id       Int    @id @default(autoincrement())
  userId   Int    @map("user_id")
  name     String
  order    Int    @default(0)
  daylioId Int?   @unique @map("daylio_id")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities Activity[]

  @@map("groups")
}

model Activity {
  id       Int     @id @default(autoincrement())
  userId   Int     @map("user_id")
  groupId  Int     @map("group_id")
  name     String
  icon     String?
  order    Int     @default(0)
  archived Boolean @default(false)
  daylioId Int?    @unique @map("daylio_id")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  group   Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  entries Entry[] @relation("EntryActivities")

  @@map("activities")
}

model Mood {
  id          Int     @id @default(autoincrement())
  name        String
  icon        String?
  color       String?
  moodGroupId Int     @map("mood_group_id")
  order       Int     @default(0)
  archived    Boolean @default(false)
  daylioId    Int?    @unique @map("daylio_id")

  entries Entry[]

  @@map("moods")
}

model Entry {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  localDate  DateTime @map("local_date") @db.Date
  note       String?
  isFavorite Boolean  @default(false) @map("is_favorite")
  moodId     Int?     @map("mood_id")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  mood       Mood?      @relation(fields: [moodId], references: [id])
  activities Activity[] @relation("EntryActivities")

  @@unique([userId, localDate])
  @@map("entries")
}

enum MediaType {
  GAME
  SERIE
  OTHER
}

model Media {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  name      String
  picture   String
  type      MediaType
  zoom      Float     @default(1)
  focalX    Float     @default(50) @map("focal_x")
  focalY    Float     @default(50) @map("focal_y")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  months MediaMonth[]

  @@map("media")
}

model MediaMonth {
  id      Int @id @default(autoincrement())
  mediaId Int @map("media_id")
  year    Int
  month   Int

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([mediaId, year, month])
  @@map("media_months")
}
